<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.1" />
    <!-- add clean architecture references for DTOs/abstractions only -->
    <ProjectReference Include="..\..\CrewConnect.Application\CrewConnect.Application.csproj" />
    <ProjectReference Include="..\..\CrewConnect.Domain\CrewConnect.Domain.csproj" />
  </ItemGroup>

</Project>
